#!/usr/bin/env bash
set -euo pipefail

if [ -n "${WAYLAND_DISPLAY:-}" ]; then
    export GDK_BACKEND=wayland
    unset DISPLAY XAUTHORITY
fi

APP_DIR="$HOME/.local/share/mactahoe-apps/mactahoe-app-themer"
if [ ! -d "$APP_DIR" ]; then
    APP_DIR="$HOME/.local/share/mactahoe-app-themer"
fi

exec /usr/bin/python3 "$APP_DIR/main.py" "$@"
